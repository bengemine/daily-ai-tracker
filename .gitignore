# Local settings (copy the .example files)
tracker-settings.json
tracker-config.json
echo/echo.env

# Generated by setup-scheduler.js
run-tracker.bat

# Tracker output and local test runs. Point the tracker's output folder outside
# this repo; these patterns catch it if it lands here by mistake.
ai-tracker/
validation-output/
*.log
*.jsonl
!test/fixtures/**/*.jsonl

# Tooling and OS files
node_modules/
__pycache__/
*.pyc
coverage/
.cache/
tmp/
.env
.env.*
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace
