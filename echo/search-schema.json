{
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "explanation", "question", "matches"],
  "properties": {
    "outcome": { "type": "string", "enum": ["single", "multiple", "none"] },
    "explanation": { "type": "string" },
    "question": { "type": "string" },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionKey", "confidence", "reason", "evidence"],
        "properties": {
          "sessionKey": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "reason": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
