# Copy this file to echo.env and change the values. serve.sh reads echo.env.
# echo.env is ignored by git.

# The Daily AI Tracker output folder, as a Linux path.
# Default: $ECHO_WINDOWS_HOME/ai-tracker when ECHO_WINDOWS_HOME is set, else ~/ai-tracker.
# ECHO_TRACKER=/mnt/c/Users/your-name/ai-tracker

# Your Windows user folder, as seen from WSL. Leave empty if you only use WSL agents.
# Echo uses it to read recent Windows Claude Code and Codex sessions and to resume them.
ECHO_WINDOWS_HOME=/mnt/c/Users/your-name

# Name of the WSL distro Echo runs in. The service does not always receive it from WSL.
WSL_DISTRO_NAME=Ubuntu

# Optional settings.
# ECHO_PORT=4317   (the Windows launchers expect 4317)
# ECHO_STATE=$HOME/.local/state/conversation-finder
# ECHO_MODEL=
# ECHO_HERDR_BIN=$HOME/.local/bin/herdr
